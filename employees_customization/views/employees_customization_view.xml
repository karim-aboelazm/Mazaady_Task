<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="employees_customization_form_view" model="ir.ui.view">
        <field name="name">employees.customization.form.view</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field['department_id']" position="after">
                <field name="overtime_ability" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

    <record id="employees_customization_tree_view" model="ir.ui.view">
        <field name="name">employees.customization.tree.view</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="default_order">overtime_ability desc</attribute>
            </xpath>
            <xpath expr="//tree" position="inside">
                <field name="overtime_ability"/>
            </xpath>
        </field>
    </record>

    <record id="employees_customization_search_view" model="ir.ui.view">
        <field name="name">employees.customization.search.view</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator/>
                <filter string="Overtime Ability" name="group_by_overtime" domain="[]" context="{'group_by': 'overtime_ability'}"/>
                <filter string="Overtime Allowed" name="filter_overtime_yes" domain="[('overtime_ability', '=', True)]" help="Show employees who can work overtime" />
                <separator/>
            </xpath>
        </field>
    </record>
</odoo>
