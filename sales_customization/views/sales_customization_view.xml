<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="sales_customization_view_form" model="ir.ui.view">
            <field name="name">sales.customization.view.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="discount_amount"
                           groups="sales_customization.group_discount_manager_sales"
                           widget="monetary"
                    />
                    <field name="total_amount_after_discount"
                           groups="sales_customization.group_discount_manager_sales"
                           widget="monetary"
                    />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
